# Autoclipping environment (bare-metal VPS). Copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored.
#
# WHERE SECRETS ACTUALLY LIVE ON THE VPS (important):
#   - This file at /opt/autoclipping/.env is read by `telegram-bot-api.service`
#     (EnvironmentFile) — so on the VPS it only needs TELEGRAM_API_ID / TELEGRAM_API_HASH.
#   - The PIPELINE secrets (FAL_KEY, BLOTATO_API_KEY, BLOTATO_TARGETS, TOR_PROXY) go in
#     the `mcp_servers.autoclipping.env:` block of ~/.hermes/config.yaml — Hermes only
#     passes THAT block to the tools (see AGENTS.md §6). They are listed below too so you
#     can also run the tools locally (scripts/call_tool.py reads them from your shell env).
#
# NOT here at all:
#   - No Anthropic key — the text model is Owl Alpha (OpenRouter), configured in Hermes.
#   - Telegram bot token / allowed users — set via `hermes gateway setup` (stored in
#     ~/.hermes/.env), NOT here.

# --- Telegram Bot API server credentials (REQUIRED on the VPS; read by the service) ---
# Get these from https://my.telegram.org/apps (personal account; api_hash is a SECRET).
# The self-hosted Bot API server raises the bot upload limit 20MB -> 2GB.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Pipeline secrets (on the VPS these go in the Hermes mcp_servers env: block) ---
# fal (NVIDIA Nemotron + image vision via fal-client)
FAL_KEY=

# Blotato (social publishing)
BLOTATO_API_KEY=

# Blotato publish targets — JSON array, one entry per connected account.
# See AGENTS.md §7 for the per-platform `target` fields. Example:
# BLOTATO_TARGETS=[{"accountId":"123","platform":"instagram","target":{"targetType":"instagram"}}]
BLOTATO_TARGETS=

# --- Proxy for the YouTube transcript tools ONLY (transcript + audio extraction) ---
# Datacenter/VPS IPs get blocked by YouTube. Optional residential proxy:
#   http://user:pass@host:port
# Leave blank to fall back to Tor (TOR_PROXY below). fal/Blotato/Telegram never use this.
YT_PROXY=

# Fallback proxy for the YouTube tools (used when YT_PROXY is unset/down). The host runs
# Tor on loopback; this is its SOCKS5 address. Dedicated var (NOT HTTPS_PROXY/ALL_PROXY)
# so it never routes fal/Blotato/Telegram through Tor.
TOR_PROXY=socks5://127.0.0.1:9050
