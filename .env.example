# Autoclipping environment (VPS). Copy to `.env` and fill in real values.
#   cp .env.example .env
# `.env` is gitignored and is loaded by docker-compose (env_file) / config.py.
#
# NOT here:
#   - No Anthropic key — the text model is Owl Alpha, configured inside Hermes.
#   - Telegram credentials — set via `hermes gateway setup` (stored in
#     /data/.hermes/.env on the named volume), NOT as a container env var.

# fal (NVIDIA Nemotron via fal-client)
FAL_KEY=

# Blotato (social publishing)
BLOTATO_API_KEY=

# Blotato publish targets — JSON array, one entry per connected account.
# See README.md for the per-platform `target` fields. Example:
# BLOTATO_TARGETS=[{"accountId":"123","platform":"instagram","target":{"targetType":"instagram"}}]
BLOTATO_TARGETS=

# Residential proxy for YouTube ONLY (datacenter/VPS IPs get blocked by YouTube).
# Applied to youtube-transcript-api + yt-dlp (transcript + VOD download). Format:
#   http://user:pass@host:port   (e.g. a Geonode rotating residential endpoint)
# Leave blank to go direct (expect YouTube IP blocks on a VPS). fal/Blotato/
# Telegram do NOT use this.
YT_PROXY=

# Fallback proxy for the YouTube tools ONLY (used when YT_PROXY is unset/down).
# The image runs Tor on loopback; this is its SOCKS5 address. Dedicated var (NOT
# HTTPS_PROXY/ALL_PROXY) so it never routes fal/Blotato/Telegram through Tor.
TOR_PROXY=socks5://127.0.0.1:9050

# Self-hosted Telegram Bot API server (docker-compose `telegram-bot-api` service) —
# raises the bot file limit 20MB -> 2GB so users can upload full videos. Get these
# from https://my.telegram.org/apps (personal account; api_hash is a SECRET).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=
